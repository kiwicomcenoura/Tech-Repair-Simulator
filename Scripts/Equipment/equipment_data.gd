extends Resource
## Metadata only. Creating this resource never creates a physical computer.
## No resource instance is assigned or generated by the workshop at startup.

@export var equipment_id: String = ""
@export var equipment_type: StringName = &""
@export var display_name: String = ""
@export var owner_id: String = ""
@export var owner_name: String = ""
@export var components: Dictionary = {}
@export var condition: String = "Não avaliada"
@export var maintenance_state: String = "Aguardando manutenção"
@export var inspection_profile: StringName = &""

# A session belongs to the real equipment, surviving removal from the bench.
# It is created lazily, not as a default computer in the UI.
var _inspection_session: RefCounted


func _init() -> void:
	resource_local_to_scene = true


func is_valid() -> bool:
	return not equipment_id.strip_edges().is_empty() and equipment_type != &""


func supports_inspection() -> bool:
	if not is_valid() or equipment_type != &"desktop" or inspection_profile != &"desktop_atx":
		return false
	# Missing components must remain inspectable so they can be installed.
	# The physical workshop supplies the actual component manifest and RAM view.
	return true


func get_inspection_session() -> RefCounted:
	if not supports_inspection():
		return null
	if _inspection_session == null:
		_inspection_session = preload("res://Scripts/Inspection/inspection_session.gd").new()
	return _inspection_session
