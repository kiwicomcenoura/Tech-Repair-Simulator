config_version=5

[application]
config/name="Tech Repair Simulator Launcher"
run/main_scene="res://Launcher.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false

[display]
window/size/viewport_width=580
window/size/viewport_height=340
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.071, 0.102, 1)
