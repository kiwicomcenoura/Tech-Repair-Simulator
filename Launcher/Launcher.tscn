[gd_scene format=3]

[ext_resource type="Script" path="res://launcher.gd" id="1"]

[node name="Launcher" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.89, 0.88, 1)
theme_override_font_sizes/font_size = 26
text = "Tech Repair Simulator"

[node name="Version" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="RepositoryLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "Repositório público do GitHub"

[node name="Repository" type="LineEdit" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "OWNER/REPO"
max_length = 140

[node name="Status" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
vertical_alignment = 1
autowrap_mode = 3

[node name="Progress" type="ProgressBar" parent="Margin/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
custom_minimum_size = Vector2(0, 22)

[node name="Actions" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Check" type="Button" parent="Margin/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
size_flags_horizontal = 3
text = "Verificar versão"

[node name="Install" type="Button" parent="Margin/Content/Actions"]
unique_name_in_owner = true
visible = false
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
size_flags_horizontal = 3
text = "Instalar"

[node name="Offline" type="Button" parent="Margin/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 40)
size_flags_horizontal = 3
text = "Jogar offline"
