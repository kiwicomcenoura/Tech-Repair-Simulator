[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/TechOS/app_window.gd" id="1_window"]
[ext_resource type="Script" path="res://Scripts/TechOS/app_icon.gd" id="2_icon"]

[node name="AppWindow" type="PanelContainer"]
custom_minimum_size = Vector2(420, 300)
layout_mode = 0
offset_right = 650.0
offset_bottom = 420.0
theme_type_variation = &"AppFrame"
script = ExtResource("1_window")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12


[node name="TitleMargin" type="MarginContainer" parent="Layout"]
